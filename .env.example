# Postgres connection string.
# Get a free one from the Vercel dashboard: Storage tab -> Create Database -> Prisma Postgres
# or run `npx create-db`.
#
# On Vercel, if you connect a Postgres/Prisma Postgres database via the
# Storage tab, this can be left unset — the app also reads the project's
# auto-injected *_POSTGRES_URL / *_DATABASE_URL variables (see lib/dbUrl.js).
# Locally, set it here.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Admin dashboard (/admin) — protects the leads list.
# Pick a strong password and a long random secret (e.g. `openssl rand -hex 32`).
ADMIN_PASSWORD="change-me"
ADMIN_JWT_SECRET="change-me-too"
